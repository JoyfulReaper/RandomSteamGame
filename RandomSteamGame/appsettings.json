{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Steam": {
    "ApiKey": "YOUR_STEAM_API_KEY_HERE",
    "ConnectionString": "Data Source=steam_cache.db",
    "Cache": {
      "OwnedGames": { "AbsoluteMinutes": 43200 },
      "AppDetails": { "AbsoluteMinutes": 43200 },
      "AppDetailsNotFound": { "AbsoluteMinutes": 15 },
      "VanitySuccess": { "AbsoluteMinutes": 21600 },
      "VanityNotFound": { "AbsoluteMinutes": 15 },
      "SteamDeckCompatibility": { "AbsoluteMinutes": 1440 }
    },
    "RateLimiting": {
      "PermitLimit": 20,
      "WindowSeconds": 10
    },
    "LibraryExport": {
      "GlobalConcurrency": 2,
      "RateLimitMode": "PerIp",
      "GlobalCooldownMinutes": 20
    }
  },
  "Application": {
    "NetworkMode": "Public",
    "NetworkName": "",
    "AllowRemoteBrowserAssets": null,
    "EnableBetaProbe": null,
    "CanonicalOrigin": null,
    "BetaHost": "randombeta.kgivler.com",
    "CommitSha": "",
    "DeploymentType": ""
  },
  "Ingress": {
    "EnableForwardedHeaders": null,
    "EnableCloudflareVisitorHeader": null,
    "TrustedProxies": null
  },
  "Cors": {
    "AllowedOrigins": [
      "https://randomsteam.kgivler.com",
      "https://randombeta.kgivler.com",
      "https://kgivler.com",
      "https://www.kgivler.com",
      "http://site.ygg.kgivler.com",
      "https://kgivler.dn42",
      "http://kgivler.dn42",
      "http://[301:762f:80bd:20e1::40]"
    ]
  },
  "DataProtection": {
    "ApplicationName": "RandomSteamGame",
    "KeysPath": ""
  },
  "MissionControl": {
    "Enabled": false,
    "BaseUrl": "https://missioncontrol.kgivler.com",
    "ApiKey": "",
    "CloudflareAccessClientId": "",
    "CloudflareAccessClientSecret": "",
    "TimeoutMilliseconds": 1000
  },
  "Telemetry": {
    "VisitorHashKey": ""
  },
  "AllowedHosts": "*"
