@inherits LayoutComponentBase

@using Microsoft.Extensions.Options
@using RandomSteamGame.Options
@inject IOptions<ApplicationOptions> ApplicationSettings
@inject IOptions<HostingOptions> HostingSettings

<div class="page-wrapper">
    <header class="global-header">
        <NavMenu />
    </header>

    <main class="main-content-area">
        @Body
    </main>

    <footer class="global-footer">
        <div class="container text-center">
            <div class="global-footer-links">
                <span>Also available on:</span>

                <a href="https://randomsteam.kgivler.com/"
                   rel="noopener noreferrer">
                    Clearnet
                </a>

                <span>·</span>

                <a href="https://steam.ygg.kgivler.com/"
                   rel="noopener noreferrer">
                    Yggdrasil
                </a>

                <span>·</span>

                <a href="https://randomsteam.dn42/"
                   rel="noopener noreferrer">
                    DN42
                </a>

                <span>·</span>

                <a href="http://vdjmun2zeeqdk7lymwe6qht2msioyq2y6ywpjduchqye3nodfbmq.b32.i2p"
                   rel="noopener noreferrer">
                    I2P (experimental)
                </a>

                <span class="global-footer-divider">|</span>

                <a href="https://github.com/JoyfulReaper/RandomSteamGame"
                   target="_blank"
                   rel="noopener noreferrer">
                    Project / Source
                </a>
            </div>

            <div class="global-footer-note">
                @if (ApplicationSettings.Value.RemoteBrowserAssetsAllowed)
                {
                    <text>Game background images are loaded from clearnet resources and may
                    not be available on an isolated Yggdrasil or DN42 connection.</text>
                }
                else
                {
                    <text>Remote game artwork and embedded images are disabled for this
                    @ApplicationSettings.Value.NetworkDisplayName deployment.</text>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(HostingSettings.Value.Message) || !string.IsNullOrWhiteSpace(HostingSettings.Value.ProviderName))
            {
                <div class="global-footer-links mt-1 global-footer-hosting">
                    <span>@HostingSettings.Value.Message</span>

                    @if (!string.IsNullOrWhiteSpace(HostingSettings.Value.ProviderName))
                    {
                        @if (!string.IsNullOrWhiteSpace(HostingSettings.Value.LinkUrl))
                        {
                            <a href="@HostingSettings.Value.LinkUrl"
                               target="_blank"
                               rel="@(HostingSettings.Value.HasAffiliateLink ? "sponsored noopener noreferrer" : "noopener noreferrer")">
                                @HostingSettings.Value.ProviderName
                            </a>
                        }
                        else
                        {
                            <span>@HostingSettings.Value.ProviderName</span>
                        }
                    }
                </div>
            }

            @if (HostingSettings.Value.ShowAffiliateDisclosure && HostingSettings.Value.HasAffiliateLink)
            {
                <div class="global-footer-note global-footer-affiliate-disclosure">
                    Affiliate link — I may earn a commission if you sign up through it.
                </div>
            }

            <div class="global-footer-links mt-1">
                <span>Network projects:</span>

                <a href="https://yggdrasil-network.github.io/"
                   target="_blank"
                   rel="noopener noreferrer">
                    Yggdrasil
                </a>

                <span>·</span>

                <a href="https://dn42.dev/Home"
                   target="_blank"
                   rel="noopener noreferrer">
                    DN42
                </a>
            </div>
        </div>
    </footer>
</div>
