@inherits LayoutComponentBase

@using Microsoft.Extensions.Options
@using RandomSteamGame.Options
@inject IOptions<ApplicationOptions> ApplicationSettings

<div class="page-wrapper">
    <header class="global-header">
        <NavMenu />
    </header>

    <main class="main-content-area">
        @Body
    </main>

    <footer class="global-footer">
        <div class="container text-center">
            <div class="global-footer-links">
                <span>Also available on:</span>

                <a href="https://randomsteam.kgivler.com/"
                   rel="noopener noreferrer">
                    Clearnet
                </a>

                <span>·</span>

                <a href="https://steam.ygg.kgivler.com/"
                   rel="noopener noreferrer">
                    Yggdrasil
                </a>

                <span>·</span>

                <a href="https://randomsteam.dn42/"
                   rel="noopener noreferrer">
                    DN42
                </a>

                <span class="global-footer-divider">|</span>

                <a href="https://github.com/JoyfulReaper/RandomSteamGame"
                   target="_blank"
                   rel="noopener noreferrer">
                    Project / Source
                </a>
            </div>

            <div class="global-footer-note">
                @if (ApplicationSettings.Value.RemoteBrowserAssetsAllowed)
                {
                    <text>Game background images are loaded from clearnet resources and may
                    not be available on an isolated Yggdrasil or DN42 connection.</text>
                }
                else
                {
                    <text>Remote game artwork and embedded images are disabled for this
                    @ApplicationSettings.Value.NetworkDisplayName deployment.</text>
                }
            </div>

            <div class="global-footer-links mt-1">
                <span>Proudly hosted with</span>

                <a href="https://greencloudvps.com/billing/aff.php?aff=10295"
                   target="_blank"
                   rel="sponsored noopener noreferrer">
                    GreenCloud VPS
                </a>
            </div>

            <div class="global-footer-note">
                Affiliate link — I may earn a commission if you sign up through it.
            </div>

            <div class="global-footer-links mt-1">
                <span>Network projects:</span>

                <a href="https://yggdrasil-network.github.io/"
                   target="_blank"
                   rel="noopener noreferrer">
                    Yggdrasil
                </a>

                <span>·</span>

                <a href="https://dn42.dev/Home"
                   target="_blank"
                   rel="noopener noreferrer">
                    DN42
                </a>
            </div>
        </div>
    </footer>
</div>
