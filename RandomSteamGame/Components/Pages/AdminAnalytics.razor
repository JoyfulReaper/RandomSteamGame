@page "/admin/analytics"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "SteamAdmin")]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using RandomSteamGame.Services.Analytics

@inject IJSRuntime JS
@inject ILogger<AdminAnalytics> Logger

<PageTitle>Analytics - Random Steam Game</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
</HeadContent>

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Random Steam Analytics</h1>
            <p class="text-secondary mb-0">
                Private application statistics from Mission Control Archive.
            </p>
        </div>

        <div class="btn-group" role="group" aria-label="Analytics period">
            @foreach (var days in new[] { 7, 30, 90 })
            {
                <button type="button"
                        class="btn @(_selectedDays == days ? "btn-primary" : "btn-outline-primary")"
                        disabled="@_loading"
                        @onclick="() => LoadOverviewAsync(days)">
                    @days days
                </button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <p role="status">Loading analytics…</p>
    }
    else if (_loadFailed)
    {
        <div class="alert alert-warning" role="alert">
            Analytics are currently unavailable.
            Mission Control may be offline or analytics may not be configured.
        </div>

        <button class="btn btn-outline-primary"
                @onclick="() => LoadOverviewAsync(_selectedDays)">
            Retry
        </button>
    }
    else if (_overview is { } overview)
    {
        <p class="text-secondary small mb-4">
            Reporting period:
            @overview.FromUtc.ToString("yyyy-MM-dd") through
            @overview.ToUtc.AddDays(-1).ToString("yyyy-MM-dd") (UTC).
            Current partial day excluded.
        </p>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var metric in GetMetrics(overview))
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-light border-secondary">
                        <div class="card-body">
                            <p class="text-secondary small mb-2">
                                @metric.Label
                            </p>

                            <div class="fs-2 fw-semibold">
                                @metric.Value.ToString("N0")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <p class="text-secondary small mt-4">
            Counts are based on archived telemetry events.
            Identified visitors are distinct telemetry IDs, not necessarily
            distinct people. These figures may differ from the site's
            lifetime counters.
        </p>
    }
</div>

@code {
    private IJSObjectReference? _module;
    private RandomSteamOverview? _overview;
    private int _selectedDays = 30;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/adminAnalytics.js");

            await LoadOverviewAsync(_selectedDays);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Unable to initialize analytics dashboard.");
            _loadFailed = true;
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadOverviewAsync(int days)
    {
        if (_module is null || _disposed)
            return;

        _selectedDays = days;
        _loading = true;
        _loadFailed = false;
        _overview = null;

        try
        {
            _overview = await _module.InvokeAsync<RandomSteamOverview>(
                "getAnalyticsOverview", days);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection was closed.
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Unable to retrieve analytics overview.");
            _loadFailed = true;
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static IEnumerable<(string Label, long Value)> GetMetrics(
        RandomSteamOverview overview)
    {
        return
        [
            ("Homepage visits", overview.HomepageVisits),
            ("Identified visitors", overview.IdentifiedVisitors),
            ("Picker attempts", overview.PickerAttempts),
            ("Successful picks", overview.SuccessfulPicks),
            ("Failed picks", overview.FailedPicks),
            ("Library exports", overview.CompletedExports)
        ];
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected.
            }
        }
    }
}
