@page "/"

@inject IBetaAvailabilityService BetaAvailabilityService
@inject IAppStatsService AppStatsService
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Home> Logger
@inject CanonicalUrlService CanonicalUrls

<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta name="description" content="Paste your Steam ID or vanity URL to pick a random game from your public Steam library, filter to unplayed games, and choose again in seconds." />
    <meta name="author" content="Kyle Givler" />
</HeadContent>

<PageTitle>Random Steam Game Picker – Pick From Your Library</PageTitle>

<div class="container mt-5 home-shell">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            @if (_isBetaSite)
            {
                <div class="home-beta-note-wrap mb-4">
                    <div class="home-beta-note" role="note">
                        <span class="home-beta-note-pill">Beta site</span>
                        <span class="home-beta-note-text">
                            You are on the beta build.
                            Stable release is at
                            <a href="https://randomsteam.kgivler.com/"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="home-beta-note-link">randomsteam.kgivler.com</a>.
                        </span>
                    </div>
                </div>
            }
            else if (_betaAvailable)
            {
                <div class="home-beta-banner-wrap mb-4">
                    <div class="home-beta-banner">
                        <div class="text-center text-md-start">
                            <span class="home-beta-pill">Beta available</span>
                            <span class="home-beta-text">A live beta picker is running right now.</span>
                        </div>
                        <a href="https://randombeta.kgivler.com/"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="home-beta-link">Click here to try it</a>
                    </div>
                </div>
            }

            <div class="home-card rsg-led-breathe-purple">
                <p class="home-eyebrow text-center mb-2">
                    Steam library roulette
                </p>

                <h1 class="home-title text-center mb-3">Random Steam Game Picker</h1>

                <p class="home-lead text-center small mb-4">
                    Paste a Steam ID or vanity URL to pick a random game from your library.
                </p>

                <SteamPickerForm @rendermode="InteractiveAuto" />
            </div>

            <footer class="home-footer text-center mt-4 text-muted small">
                <p>
                    Need help finding your Steam ID?
                    Check the
                    <a href="https://help.steampowered.com/en/faqs/view/2816-BE67-5B69-0FEC"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">Steam ID guide</a>.
                    Ensure your
                    <a href="https://help.steampowered.com/en/faqs/view/588C-C67D-0251-C276"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">profile is public</a>.
                </p>

                <HomeStats Stats="_appStats" />

                <p>
                    Please Report Any <span class="text-danger">Bugs:</span>
                    <a href="https://github.com/JoyfulReaper/RandomSteamGame/issues"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">GitHub Issues</a>
                </p>
            </footer>
        </div>
    </div>

    <section class="home-guide mt-5" aria-labelledby="how-it-works-heading">
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="home-info-card h-100">
                    <h2 id="how-it-works-heading">How it works</h2>
                    <ol class="home-steps mb-0">
                        <li>Enter your 17-digit Steam ID or Steam vanity URL.</li>
                        <li>The picker reads the games in your public Steam library.</li>
                        <li>It randomly chooses a game you actually own.</li>
                        <li>Choose again immediately whenever the first pick does not fit.</li>
                        <li>Turn on unplayed-only mode to limit picks to games with no recorded playtime.</li>
                    </ol>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="home-info-card h-100">
                    <h2>Useful picker features</h2>
                    <ul class="home-feature-list mb-0">
                        <li><strong>Unplayed-only picks:</strong> focus on games with no Steam playtime recorded.</li>
                        <li><strong>Quick rerolls:</strong> choose another owned game without returning to the form.</li>
                        <li><strong>Browser-based exclusions:</strong> block an unwanted game from future picks in this browser, then reset the list whenever you want.</li>
                        <li><strong>Fresh library data:</strong> refresh the cached Steam game list after buying new games if your picks look out of date.</li>
                        <li><strong>Launch through Steam:</strong> open the selected game directly in the Steam client.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="home-faq mt-4" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Does my Steam profile need to be public?</h3>
                        <p>Yes. Steam must allow access to your profile and game details so the picker can read your owned games.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Where do I find my Steam ID?</h3>
                        <p>You can use your 17-digit Steam ID, or paste the custom name or URL from your Steam Community profile.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Can it pick only games I have never played?</h3>
                        <p>Yes. Select “Only pick unplayed games” to use games for which Steam reports no recorded playtime.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Can I choose again or exclude a game?</h3>
                        <p>Yes. You can choose again instantly, or block the current game from future picks in this browser.</p>
                    </div>
                </div>

                <div class="col-12">
                    <div class="home-faq-item">
                        <h3>Does Random Steam Game change anything in my library?</h3>
                        <p>No. It reads your public game list to make a pick; it does not add, remove, or organize games in your Steam library.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string CanonicalUrl => CanonicalUrls.GetCanonicalUrl();
    private bool _betaAvailable;
    private bool _isBetaSite;
    private AppStatsResponse? _appStats;

    protected override async Task OnInitializedAsync()
    {
        _isBetaSite = CanonicalUrls.IsBetaHost(
            HttpContextAccessor.HttpContext?.Request.Host.Host);

        await LoadAppStatsAsync();

        if (!_isBetaSite)
        {
            _betaAvailable = await BetaAvailabilityService.IsBetaAvailableAsync();
        }
    }

    private async Task LoadAppStatsAsync()
    {
        try
        {
            var ip = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();
            _appStats = string.IsNullOrWhiteSpace(ip)
                ? await AppStatsService.GetStatsAsync()
                : await AppStatsService.RecordHitAsync(ip);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load home page stats.");
            _appStats = await AppStatsService.GetStatsAsync();
        }
    }
}
