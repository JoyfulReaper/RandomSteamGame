@page "/"

@inject IBetaAvailabilityService BetaAvailabilityService
@using Microsoft.Extensions.Options
@using RandomSteamGame.Options
@inject IOptions<ApplicationOptions> ApplicationSettings
@inject IOptions<LibraryExportOptions> ExportSettings
@inject IAppStatsService AppStatsService
@inject IRecentPickService RecentPickService
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Home> Logger
@inject CanonicalUrlService CanonicalUrls

<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta name="description" content="@Description" />
    <meta name="author" content="Kyle Givler" />
    <SocialMetadata Title="@Title" Description="@Description" CanonicalUrl="@CanonicalUrl" />
    @((MarkupString)StructuredDataScript)
</HeadContent>

<PageTitle>@Title</PageTitle>

<div class="container mt-5 home-shell">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            @if (ShowPublicBetaLinks && _isBetaSite)
            {
                <div class="home-beta-note-wrap mb-4">
                    <div class="home-beta-note" role="note">
                        <span class="home-beta-note-pill">Beta site</span>
                        <span class="home-beta-note-text">
                            You are on the beta build.
                            Stable release is at
                            <a href="https://randomsteam.kgivler.com/"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="home-beta-note-link">randomsteam.kgivler.com</a>.
                        </span>
                    </div>
                </div>
            }
            else if (ShowPublicBetaLinks && _betaAvailable)
            {
                <div class="home-beta-banner-wrap mb-4">
                    <div class="home-beta-banner">
                        <div class="text-center text-md-start">
                            <span class="home-beta-pill">Beta available</span>
                            <span class="home-beta-text">A live beta picker is running right now.</span>
                        </div>
                        <a href="https://randombeta.kgivler.com/"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="home-beta-link">Click here to try it</a>
                    </div>
                </div>
            }

            <div class="home-card rsg-led-breathe-purple">
                <p class="home-eyebrow text-center mb-2">
                    Steam library roulette
                </p>

                <h1 class="home-title text-center mb-3">Random Steam Game Picker</h1>

                <p class="home-lead text-center small mb-4">
                    Paste a Steam ID or vanity URL to pick a random game from your library.
                </p>

                <SteamPickerForm @rendermode="InteractiveAuto" />
            </div>

            @if (_recentPicks.Count > 0)
            {
                <section class="home-info-card home-recent-picks mt-3" aria-labelledby="recent-picks-heading">
                    <h2 id="recent-picks-heading" class="h5 mb-2">Recent Picks</h2>
                    <ul class="list-unstyled mb-0">
                        @foreach (var pick in _recentPicks)
                        {
                            <li>
                                <a href="https://store.steampowered.com/app/@(pick.AppId)/"
                                   target="_blank" rel="noopener noreferrer" class="text-info">@pick.GameName</a>
                                <div class="home-recent-pick-details">
                                    <time datetime="@pick.PickedAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">
                                        @pick.PickedAtUtc.ToString("MMM d, HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)
                                    </time>
                                    <a href="https://store.steampowered.com/app/@(pick.AppId)/"
                                       target="_blank" rel="noopener noreferrer"
                                       class="home-recent-pick-store-link text-info"
                                       aria-label="View @pick.GameName on Steam">View on Steam</a>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }

            <div class="home-info-card home-library-export-card mt-3 text-center">
                <h2 class="h5 mb-2">Need your whole Steam library?</h2>

                <p class="small mb-3">
                    Export your public Steam library to CSV for Excel or another
                    spreadsheet app. The file includes game names, App IDs,
                    playtime, last-played dates, and Steam Deck compatibility.
                </p>

                <a href="/library-export"
                   class="btn btn-outline-info btn-sm">
                    Export Steam Library to CSV
                </a>
            </div>

            <footer class="home-footer text-center mt-4 text-muted small">
                <p>
                    Need help finding your Steam ID?
                    Check the
                    <a href="https://help.steampowered.com/en/faqs/view/2816-BE67-5B69-0FEC"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">Steam ID guide</a>.
                    Ensure your
                    <a href="https://help.steampowered.com/en/faqs/view/588C-C67D-0251-C276"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">profile is public</a>.
                </p>

                <HomeStats Stats="_appStats" />

                <p>
                    Please Report Any <span class="text-danger">Bugs:</span>
                    <a href="https://github.com/JoyfulReaper/RandomSteamGame/issues"
                       target="_blank"
                       class="text-info"
                       rel="noopener noreferrer">GitHub Issues</a>
                </p>
            </footer>
        </div>
    </div>

    <section class="home-guide mt-5" aria-labelledby="how-it-works-heading">
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="home-info-card h-100">
                    <h2 id="how-it-works-heading">How it works</h2>
                    <ol class="home-steps mb-0">
                        <li>Enter your 17-digit Steam ID or Steam vanity URL.</li>
                        <li>The picker reads the games in your public Steam library.</li>
                        <li>It randomly chooses a game you actually own.</li>
                        <li>Choose again immediately whenever the first pick does not fit.</li>
                        <li>Turn on unplayed-only mode to limit picks to games with no recorded playtime.</li>
                    </ol>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="home-info-card h-100">
                    <h2>Useful Steam library features</h2>
                    <ul class="home-feature-list mb-0">
                        <li><strong>Unplayed-only picks:</strong> focus on games with no Steam playtime recorded.</li>
                        <li><strong>Quick rerolls:</strong> choose another owned game without returning to the form.</li>
                        <li><strong>Browser-based exclusions:</strong> block an unwanted game from future picks in this browser, then reset the list whenever you want.</li>
                        <li><strong>Fresh library data:</strong> refresh the cached Steam game list after buying new games if your picks look out of date.</li>
                        <li><strong>Launch through Steam:</strong> open the selected game directly in the Steam client.</li>
                        <li><strong>Steam library CSV export:</strong> download your public library as a spreadsheet-ready CSV for Excel, LibreOffice Calc, Google Sheets, or another spreadsheet tool.
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <section class="home-info-card home-finger-card mt-4" aria-labelledby="finger-heading">
            <div class="home-finger-copy">
                <p class="home-eyebrow mb-2">Old-school interface</p>
                <h2 id="finger-heading">Pick a random Steam game over Finger</h2>
                <p class="mb-0">
                    Use the Finger protocol as a fun alternative for choosing a game
                    from a public Steam library. It expects a 17-digit Steam ID;
                    vanity URLs are not supported.
                </p>
            </div>
            <div class="home-finger-command-wrap">
                <span class="home-finger-command-label">Command</span>
                <code class="home-finger-command">finger &lt;steamId&gt;&#64;finger.kgivler.com</code>
            </div>
        </section>

        <section class="home-info-card home-irc-card mt-4" aria-labelledby="irc-heading">
            <div class="home-irc-copy">
                <p class="home-eyebrow mb-2">Chat interface</p>
                <h2 id="irc-heading">Pick a random Steam game over IRC</h2>
                <p class="mb-0">
                    Join the Random Steam Game channel on Libera.Chat and ask the bot
                    to pick a game from your public Steam library using either your
                    17-digit Steam ID or Steam vanity name.
                </p>
            </div>

            <div class="home-finger-command-wrap">
                <span class="home-finger-command-label">IRC</span>
                <code class="home-finger-command">irc.libera.chat / #randomsteamgame</code>
            </div>

            <div class="home-finger-command-wrap mt-2">
                <span class="home-finger-command-label">Command</span>
                <code class="home-finger-command">!random &lt;SteamID or vanity name&gt;</code>
            </div>
        </section>

        
        <section class="home-info-card home-matrix-card mt-4" aria-labelledby="matrix-heading">
            <p class="home-eyebrow mb-2">Chat interface</p>
            <h2 id="matrix-heading">Pick a random Steam game over Matrix</h2>

            <p>
                Join the Random Steam Game room on Matrix and ask RandomSteamBot
                to pick a game from your public Steam library using your
                17-digit Steam ID or Steam vanity name.
            </p>

            <p class="mb-3">
                <a href="https://matrix.to/#/!NTvCQirbQTeqzUiSoh:kgivler.com"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-info">
                    Join the Random Steam Game Matrix room
                </a>
            </p>

            <div class="home-finger-command-wrap">
                <span class="home-finger-command-label">Command</span>
                <code class="home-finger-command">!steam &lt;SteamID or vanity name&gt;</code>
            </div>
        </section>


        <div class="home-faq mt-4 mb-4" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Does my Steam profile need to be public?</h3>
                        <p>
                            Yes. Steam must allow access to your profile and game details
                            so the picker can read your owned games.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Where do I find my Steam ID?</h3>
                        <p>
                            You can use your 17-digit Steam ID, or paste the custom name
                            or URL from your Steam Community profile.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Can it pick only games I have never played?</h3>
                        <p>
                            Yes. Select “Only pick unplayed games” to use games for which
                            Steam reports no recorded playtime.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Can I choose again or exclude a game?</h3>
                        <p>
                            Yes. You can choose again instantly, or block the current game
                            from future picks in this browser.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Can I export my Steam library?</h3>
                        <p>
                            Yes. Export your public Steam library as CSV, then open it in
                            Excel, LibreOffice Calc, Google Sheets, or another spreadsheet
                            app. It includes game names, App IDs, playtime, last-played
                            dates, and Steam Deck compatibility.
                            @if (ExportSettings.Value.RateLimitMode == LibraryExportRateLimitMode.Global)
                            {
                                @ExportSettings.Value.RateLimitDescription
                            }
                            else
                            {
                                <text>Exports are limited to one per IP address every
                                72 hours.</text>
                            }
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="home-faq-item h-100">
                        <h3>Does Random Steam Game change anything in my library?</h3>
                        <p>
                            No. It reads your public game list to make a pick or export your
                            library; it does not add, remove, or organize games in Steam.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private const string Title = "Random Steam Game Picker – Pick From Your Library";
    private const string Description = "Pick a random game from your public Steam library, filter to unplayed games, or export your Steam library to CSV for Excel and other spreadsheet apps.";

    private string CanonicalUrl => CanonicalUrls.GetCanonicalUrl();
    private bool ShowPublicBetaLinks =>
        ApplicationSettings.Value.NetworkMode == NetworkMode.Public && ApplicationSettings.Value.BetaProbeEnabled;
    private string StructuredDataJson => System.Text.Json.JsonSerializer.Serialize(
        new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebApplication",
            ["name"] = "Random Steam Game Picker",
            ["url"] = CanonicalUrl,
            ["description"] = Description,
            ["applicationCategory"] = "UtilitiesApplication",
            ["operatingSystem"] = "Any device with a web browser",
            ["isAccessibleForFree"] = true,
            ["featureList"] = new[]
                {
                    "Random game selection from a public Steam library",
                    "Unplayed-only game filtering",
                    "Browser-based game exclusions",
                    "Steam library CSV export for Excel and other spreadsheet apps",
                    "Steam Deck compatibility included in library exports",
                    "Random Steam game selection over the Finger protocol",
                    "Random Steam game selection through an IRC bot on Libera.Chat",
                    "Random Steam game selection through a Matrix bot"
                }
        });
    private string StructuredDataScript =>
        $"<script type=\"application/ld+json\">{StructuredDataJson}</script>";

    private bool _betaAvailable;
    private bool _isBetaSite;
    private AppStatsResponse? _appStats;
    private IReadOnlyList<RecentPick> _recentPicks = [];

    protected override async Task OnInitializedAsync()
    {
        _isBetaSite = CanonicalUrls.IsBetaHost(
            HttpContextAccessor.HttpContext?.Request.Host.Host);

        await LoadAppStatsAsync();
        await LoadRecentPicksAsync();

        if (ApplicationSettings.Value.BetaProbeEnabled && !_isBetaSite)
        {
            _betaAvailable = await BetaAvailabilityService.IsBetaAvailableAsync();
        }
    }

    private async Task LoadRecentPicksAsync()
    {
        try
        {
            _recentPicks = await RecentPickService.GetRecentAsync(5);
        }
        catch (Exception exception)
        {
            _recentPicks = [];
            Logger.LogWarning(exception, "Failed to load recent picks for homepage.");
        }
    }

    private async Task LoadAppStatsAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        var ip = httpContext?.Connection.RemoteIpAddress?.ToString();

        var userAgent = httpContext?.Request.Headers["User-Agent"].ToString();

        var ingressNetwork = RandomSteamIngressNetwork.FromHost(httpContext?.Request.Host.Host);

        var recordHit = !string.IsNullOrWhiteSpace(ip);
        try
        {
            _appStats = recordHit
                ? await AppStatsService.RecordHitAsync(ip!, userAgent, ingressNetwork)
                : await AppStatsService.GetStatsAsync();
        }
        catch (Exception exception)
        {
            _appStats = null;
            Logger.LogWarning(exception,
                "Failed to load homepage statistics during {StatsOperation}.",
                recordHit ? "hit recording" : "stats retrieval");
        }
    }
}
