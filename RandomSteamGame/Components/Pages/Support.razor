@page "/support"
@using Microsoft.Extensions.Options
@using RandomSteamGame.Options
@inject CanonicalUrlService CanonicalUrls
@inject IOptions<ApplicationOptions> ApplicationSettings

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@CanonicalUrl" />
    <SocialMetadata Title="@Title" Description="@Description" CanonicalUrl="@CanonicalUrl" />
</HeadContent>

<div class="support-page">
    <header class="support-intro">
        <p class="support-eyebrow">Support &amp; ideas</p>
        <h1>Support the Picker</h1>
        <p class="support-lead">Random Steam Game Picker is a free hobby project.
            If you'd like to help with hosting and development costs, donations are appreciated and optional.</p>
        <div class="support-links">
            <a class="btn btn-primary" href="https://ko-fi.com/joyfulreaper" target="_blank" rel="noopener noreferrer">Support on Ko-fi</a>
            <a class="btn btn-outline-light" href="@PayPalUrl" target="_blank" rel="noopener noreferrer">Donate with PayPal</a>
        </div>
    </header>

    <section id="feature-voting" class="support-section" aria-labelledby="features-heading">
        <div class="support-section-heading">
            <p class="support-eyebrow">What comes next</p>
            <h2 id="features-heading">Features I'm considering</h2>
            <p>Vote for the ideas you'd use. Votes help me understand interest; they don't promise a feature or a delivery date.</p>
            <p class="support-detail">You can support more than one feature. Votes are anonymous and saved for this browser.
                Account-linked features would need Steam sign-in first; sign-in isn't implemented yet.</p>
        </div>
        @if (ApplicationSettings.Value.NetworkMode == NetworkMode.Public)
        {
            <FeatureVotingBoard @rendermode="InteractiveAuto" />
        }
        else
        {
            <p class="support-unavailable" role="status">Feature voting is available on the clearnet site.
                You can still suggest a feature or ask about sponsorship below.</p>
        }
    </section>

    <div class="support-bottom-grid">
        <section class="support-section" aria-labelledby="suggest-heading">
            <p class="support-eyebrow">Have another idea?</p>
            <h2 id="suggest-heading">Suggest a feature</h2>
            <p>If the feature you want isn't listed, open a GitHub issue. Describe what you'd like to do and how it would help.
                Accepted proposals can be added to the voting board.</p>
            <a class="support-text-link" href="https://github.com/JoyfulReaper/RandomSteamGame/issues/new" target="_blank" rel="noopener noreferrer">Suggest a feature on GitHub <span aria-hidden="true">↗</span></a>
        </section>

        <section class="support-section" aria-labelledby="sponsorship-heading">
            <p class="support-eyebrow">Discuss a specific feature</p>
            <h2 id="sponsorship-heading">Feature sponsorship</h2>
            <p>I'm Kyle, the developer. I'm open to discussing paid development of specific features.
                Tell me which feature you're interested in so we can discuss feasibility, scope, payment, and expectations.</p>
            <p class="sponsorship-note">Please contact me before sending payment for feature sponsorship.
                Tips and donations are separate from sponsorship agreements and do not guarantee development of a feature.</p>
            <p class="support-detail">I'm open to practical payment methods I can legally receive in the United States.
                We'll agree on the details before any money changes hands.</p>
            <a class="support-text-link" href="https://dev.kgivler.com/#contact" target="_blank" rel="noopener noreferrer">Contact Kyle about sponsorship <span aria-hidden="true">↗</span></a>
        </section>
    </div>

    <p class="support-portfolio"><a href="https://dev.kgivler.com/" target="_blank" rel="noopener noreferrer">Hire me or see my developer portfolio</a></p>
</div>

@code {
    private const string Title = "Support Random Steam Game Picker";
    private const string Description = "Help with hosting, vote on proposed features, suggest an idea, or contact Kyle about feature sponsorship.";
    // Preserve the existing donation destination, including its suggested amount.
    private const string PayPalUrl = "https://www.paypal.com/paypalme/KyleGivler/5USD";
    private string CanonicalUrl => CanonicalUrls.GetCanonicalUrl("/support");
}
