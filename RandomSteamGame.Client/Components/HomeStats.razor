@if (Stats is { } stats)
{
    <p>
        Total Hits: @stats.TotalHits |
        Unique Visitors: @stats.UniqueVisitors |
        Random Games Generated: @stats.RandomGamesGenerated |
        Libraries Exported: @stats.LibrariesExported
    </p>
}
else
{
    <p>Stats temporarily unavailable.</p>
}

@code {
    [Parameter]
    public AppStatsResponse? Stats { get; set; }
}
